# ==============================================================================
# STRUCT SAAS PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Neon PostgreSQL & Local Dual-Mode)
# ------------------------------------------------------------------------------
# - In Production (NODE_ENV=production): DATABASE_URL is MANDATORY for Neon PostgreSQL.
#   Recommended: Neon connection pooled URL (e.g. postgres://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require)
# - In Local Development: If DATABASE_URL is unset, STRUCT automatically falls back to
#   embedded WAL-mode SQLite at data/talvyn_assess.db for zero-config offline work.
DATABASE_URL=

# PostgreSQL Connection Pool Configuration (20 max connections safely handles 2,000+ qps)
PG_POOL_MAX=20

# Optional SSL toggle (defaults to true for remote endpoints, false for localhost)
# PG_SSL=true

# ------------------------------------------------------------------------------
# 2. Authentication (Clerk & Mode B Exam Sessions)
# ------------------------------------------------------------------------------
# Clerk credentials for normal individual candidates and organization administrators:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dedicated secret key for signing exam-only Mode B candidate session cookies:
ASSESS_SESSION_SECRET=struct_secure_exam_session_secret_2026_key

# Initial root platform setup passcode (used to register root admin in absence of Clerk):
ASSESS_ADMIN_SETUP_CODE=replace_with_secure_random_admin_setup_secret

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (Private Resume & Audio Vault)
# ------------------------------------------------------------------------------
# Cloudflare Account ID and S3-compatible API credentials for signed uploads/downloads:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=struct-private-storage
# R2_PUBLIC_URL_PREFIX=

# ------------------------------------------------------------------------------
# 4. Transactional Email (Resend)
# ------------------------------------------------------------------------------
# Resend API key for transactional invites, payment receipts, and password resets:
# Note: Mode B exam-only pseudo-emails (e.g. *.company.in) are automatically suppressed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=STRUCT Platform <support@structonline.in>

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay Key ID and Secret (supports ₹49 AI pack and individual/org subscriptions):
RAZORPAY_KEY_ID=rzp_test_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=struct_razorpay_mock_secret_key_2026
RAZORPAY_WEBHOOK_SECRET=struct_rzp_webhook_secret_2026

# ------------------------------------------------------------------------------
# 6. AI Providers (Google Gemini & OpenAI)
# ------------------------------------------------------------------------------
# Optional: Model provider keys for AI bullet rewrites and executive summary tailoring:
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 7. LaunchGate & Preview Access Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LAUNCH_GATE_ENABLED=false
NEXT_PUBLIC_LAUNCH_PASSCODE=2118
NEXT_PUBLIC_LAUNCH_DATE=2026-10-29T09:00:00+05:30
NEXT_PUBLIC_LAUNCH_LABEL=Thursday, October 29, 2026 at 9:00 AM
NEXT_PUBLIC_SHOW_PASSCODE_HINT=true
